# Copia este archivo a .env y rellena tus valores. El .env NUNCA se sube a git.
#
# ── Claves del SERVIDOR (son un costo tuyo; nunca se exponen al navegador) ──

# Embeddings de la CONSULTA en tiempo de ejecución (el servidor la usa para
# vectorizar cada búsqueda). En producción se configura como variable de
# entorno en el host del backend, NO aquí.
GEMINI_API_KEY=

# Solo para el BUILD del índice (python -m lorguru.build_index). Se rotan para
# respetar el límite de peticiones/min del free tier. Ideal: dos proyectos de
# Google Cloud distintos → cuotas independientes. El servidor NO las necesita.
GEMINI_API_KEY_1=
GEMINI_API_KEY_2=

# Orígenes permitidos por CORS, separados por coma. En local basta el dev
# server de Next; en producción, el dominio de Vercel.
ORIGENES_CORS=http://localhost:3000

# ── Solo para la evaluación (pytest -m agente): capa B con claves propias ──
# No hacen falta para servir la app (el agente es BYOK: cada usuario pone la
# suya en el navegador).
ANTHROPIC_API_KEY=

# ── FRONTEND (webapp/) ──
# URL del backend que consume el frontend Next.js. En local apunta al uvicorn
# de arriba; en producción es el dominio del backend en Render (con https://,
# sin barra final). Se define en Vercel como variable de entorno del proyecto,
# NO en este archivo. Ejemplo de producción:
#   NEXT_PUBLIC_API_URL=https://lor-guru-api.onrender.com
NEXT_PUBLIC_API_URL=http://localhost:8000
